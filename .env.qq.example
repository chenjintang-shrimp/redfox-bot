# NoneBot2 QQ Bot 配置文件
# 复制此文件为 .env.qq 并填写实际值
# 配置参考: https://napneko.github.io/use/integration

# ==================== 基础配置 ====================

# 超级用户 QQ 号（管理员），多个用逗号分隔
SUPERUSERS=["123456789"]

# Bot 昵称
NICKNAME=["redfoxredfox-赤狐bot"]

# 命令前缀
COMMAND_START=["!","！"]

# 日志级别
LOG_LEVEL=INFO

# ==================== OneBot v11 适配器配置 ====================
# NoneBot2 默认启用反向 WebSocket，端口为 8080
# NapCat 需要配置为 WebSocket 客户端连接到 NoneBot

# 可选：访问令牌（如果 NapCat 配置了 token，这里必须一致）
ONEBOT_ACCESS_TOKEN=your_token_here

# 驱动器配置（使用反向 WebSocket）
DRIVER=~fastapi+~websockets

# 反向 WebSocket 主机和端口
HOST=127.0.0.1
PORT=8080

# ==================== NapCat 配置说明 ====================
# 1. 在 NapCat WebUI 中，网络配置 → 新建 → WebSocket 客户端
# 2. URL 填入: ws://127.0.0.1:8080/onebot/v11/ws
# 3. 如果配置了 token，在消息头中填入: Authorization: Bearer your_token
# 4. 保存并启用
